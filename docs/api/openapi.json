{
    "openapi": "3.1.0",
    "info": {
        "title": "Artistic Hub API",
        "version": "0.0.1",
        "description": "Artistic Hub API: public catalog, customer accounts, cart, checkout and orders, and the admin API under /admin."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "operationId": "customer.v1.auth.register",
                "description": "Creates an active customer account from email and password only. No token is returned: the\ncustomer signs in next, then creates their profile.",
                "summary": "Register a customer",
                "tags": [
                    "Register"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`CustomerResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CustomerResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/auth/login": {
            "post": {
                "operationId": "customer.v1.auth.login",
                "description": "Only customer accounts can sign in here; admin accounts get the same error as a wrong password.",
                "summary": "Sign in as a customer",
                "tags": [
                    "Session"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`CustomerTokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CustomerTokenResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/InvalidCredentials"
                    },
                    "403": {
                        "$ref": "#/components/responses/AccountNotActive"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/auth/me": {
            "get": {
                "operationId": "customer.v1.auth.me",
                "summary": "The signed-in customer",
                "tags": [
                    "Session"
                ],
                "responses": {
                    "200": {
                        "description": "`CustomerResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CustomerResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "customer.v1.auth.logout",
                "summary": "Sign out (revokes the current token)",
                "tags": [
                    "Session"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/admin/auth/login": {
            "post": {
                "operationId": "admin.v1.auth.login",
                "description": "Only admin accounts can sign in here; customer accounts get the same error as a wrong password.",
                "summary": "Sign in as an admin",
                "tags": [
                    "Session"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/App.Http.Requests.Admin.Auth.LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`AdminTokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AdminTokenResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/InvalidCredentials"
                    },
                    "403": {
                        "$ref": "#/components/responses/AccountNotActive"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/admin/auth/me": {
            "get": {
                "operationId": "admin.v1.auth.me",
                "summary": "The signed-in admin",
                "tags": [
                    "Session"
                ],
                "responses": {
                    "200": {
                        "description": "`AdminResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AdminResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/admin/auth/logout": {
            "post": {
                "operationId": "admin.v1.auth.logout",
                "summary": "Sign out (revokes the current token)",
                "tags": [
                    "Session"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "AdminResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "const": "admin"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "status",
                    "role",
                    "created_at"
                ],
                "title": "AdminResource"
            },
            "AdminTokenResource": {
                "type": "object",
                "properties": {
                    "token_type": {
                        "type": "string",
                        "const": "Bearer"
                    },
                    "access_token": {
                        "type": "string"
                    },
                    "expires_at": {
                        "type": "string"
                    },
                    "user": {
                        "$ref": "#/components/schemas/AdminResource"
                    }
                },
                "required": [
                    "token_type",
                    "access_token",
                    "expires_at",
                    "user"
                ],
                "title": "AdminTokenResource"
            },
            "App.Http.Requests.Admin.Auth.LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "App.Http.Requests.Admin.Auth.LoginRequest"
            },
            "CustomerResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "description": "Null until the customer creates their profile."
                    },
                    "email": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "const": "customer"
                    },
                    "profile_completed": {
                        "type": "boolean",
                        "description": "False until the profile exists; the frontend sends the customer to onboarding."
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "status",
                    "role",
                    "profile_completed",
                    "created_at"
                ],
                "title": "CustomerResource"
            },
            "CustomerTokenResource": {
                "type": "object",
                "properties": {
                    "token_type": {
                        "type": "string",
                        "const": "Bearer"
                    },
                    "access_token": {
                        "type": "string"
                    },
                    "expires_at": {
                        "type": "string"
                    },
                    "user": {
                        "$ref": "#/components/schemas/CustomerResource"
                    }
                },
                "required": [
                    "token_type",
                    "access_token",
                    "expires_at",
                    "user"
                ],
                "title": "CustomerTokenResource"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Unique across all users, including soft-deleted ones: their email stays reserved.",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string"
                    },
                    "password_confirmation": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "title": "RegisterRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "InvalidCredentials": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AccountNotActive": {
                "description": "Authorization error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}